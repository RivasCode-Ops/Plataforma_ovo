# Copie para infra/.env.prod e preencha antes do deploy:
#   cp env.prod.example .env.prod

# Porta HTTP exposta na VPS (use 80 em produção; 8080 se 80 estiver ocupada)
HTTP_PORT=80

# PostgreSQL
POSTGRES_USER=plataforma
POSTGRES_PASSWORD=TROQUE_SENHA_FORTE_AQUI
POSTGRES_DB=plataforma_ovo

# API
JWT_SECRET=TROQUE_STRING_LONGA_ALEATORIA
ADMIN_USER=admin
ADMIN_PASSWORD=TROQUE_SENHA_ADMIN

# URL pública do painel (para CORS) — ex.: https://app.suagranja.com.br
CORS_ORIGIN=https://app.suagranja.com.br

# WhatsApp granja (só dígitos, com 55)
GRANJA_WHATSAPP=5511999999999

# Site (quando reativar granjauniao.com.br)
SITE_ORIGEM=granjauniao.com.br
SITE_NOME=Granja União
WEBHOOK_SECRET=TROQUE_WEBHOOK_SECRET

# Não usar em produção:
# USE_MEMORY_DB=1
